# 이 파일을 .env.local 로 복사해 값을 채우세요.
# 값을 비워 두면 데모 모드(서버 메모리의 샘플 글, 체험용 로그인)로 실행됩니다.

# Supabase 프로젝트 > Project Settings > API
NEXT_PUBLIC_SUPABASE_URL=
# anon(또는 publishable) 키. 브라우저에 공개되는 키입니다.
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# service_role(또는 secret) 키. 서버에서만 쓰며 절대 공개하면 안 됩니다.
SUPABASE_SERVICE_ROLE_KEY=

# 배포 주소 (예: https://thisorthat.example). 로그인 후 돌아올 주소와 공유 미리보기에 씁니다.
NEXT_PUBLIC_SITE_URL=

# IP 해시에 섞는 임의의 긴 문자열 (선택). 비우면 service_role 키를 대신 씁니다.
VOTE_SALT=
